# Do not enable production clinical inputs or use real patient data without release approvals.
APP_ENV=production
DEMO_MODE=false
DATABASE_URL=postgresql+psycopg://vaidya:REPLACE@postgres:5432/vaidya
FLASK_SECRET_KEY=REPLACE_WITH_64_RANDOM_CHARACTERS
AWS_REGION=ap-south-1
AWS_DEFAULT_REGION=ap-south-1
VAIDYA_S3_BUCKET=REPLACE_WITH_PRIVATE_BUCKET
VAIDYA_S3_UPLOAD_ORIGIN=https://REPLACE_WITH_PRIVATE_BUCKET.s3.ap-south-1.amazonaws.com
VAIDYA_S3_KMS_KEY=REPLACE_WITH_AWS_KMS_KEY_ARN
VAIDYA_ALLOWED_ORIGINS=https://your-approved-domain.example
LLM_PROVIDER=bedrock
LLM_EXTRACTION_MODEL=in.openai.gpt-5.6-terra
LLM_TRANSLATION_MODEL=in.openai.gpt-5.6-terra
BEDROCK_MODELS=in.openai.gpt-5.6-terra,in.openai.gpt-5.6-luna
VAIDYA_CLOUD_OPERATIONS_APPROVED=false
VAIDYA_CLINICAL_INPUTS_APPROVED=false
# For initial development only, set AWS_BEARER_TOKEN_BEDROCK privately. Prefer IAM roles on AWS.

# Sarvam has not been approved for real patient audio in this release candidate.
ASR_PROVIDER=sarvam
SARVAM_API_KEY=
SARVAM_MODE=codemix
SARVAM_LANGUAGE_CODE=unknown
# Remain disabled until service-provider approval, data residency, security and clinical governance are documented.
VAIDYA_SARVAM_CLINICAL_APPROVED=false
ALLOW_REMOTE_SYNTHETIC_INPUT=false
