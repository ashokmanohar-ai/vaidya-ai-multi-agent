# Copy to .env. The .env file is ignored by Git and excluded from the ZIP.
# Audio-only evaluation workflow: no patient selection or synthetic patient registry.
# Patient candidates are extracted from live ASR only after successful transcription.
DEMO_MODE=true
# Requires a real uploaded audio file. Disables typed/sample transcription input.
AUDIO_ONLY_MODE=true
APP_ENV=development
PORT=5055
FLASK_SECRET_KEY=replace-with-a-long-local-random-secret
LLM_PROVIDER=bedrock
# Change to bedrock only after supplying your secret and explicitly opting in below.
AWS_REGION=ap-south-1
AWS_DEFAULT_REGION=ap-south-1
# Recommended: SSO/IAM profile (SigV4), avoiding bearer token/signature conflicts.
# Run: aws configure list-profiles; aws sso login --profile <your-profile>
BEDROCK_AUTH_MODE=profile
AWS_PROFILE=bedrock
# To use a genuine Bedrock API key instead: set BEDROCK_AUTH_MODE=bearer,
# remove AWS_PROFILE, then configure AWS_BEARER_TOKEN_BEDROCK.
# AWS_BEARER_TOKEN_BEDROCK=
# Restrict model selection to Bedrock IDs approved for this account and region.
BEDROCK_MODELS=in.openai.gpt-5.6-terra,in.openai.gpt-5.6-luna,global.openai.gpt-5.6-sol,global.anthropic.claude-sonnet-5,global.amazon.nova-2-lite-v1:0,openai.gpt-oss-120b-1:0
LLM_EXTRACTION_MODEL=in.openai.gpt-5.6-terra
# Reserved for the future optional LLM-assisted learner; not currently invoked.
LLM_LEARNING_MODEL=in.openai.gpt-5.6-luna
ALLOW_REMOTE_SYNTHETIC_INPUT=false
# Optional, ONLY where the selected Bedrock model/inference profile supports it.
BEDROCK_STRUCTURED_OUTPUT=false
# Optional inference controls
BEDROCK_MAX_OUTPUT_TOKENS=1800
# BEDROCK_TEMPERATURE=0
# VAIDYA_DATA_DIR=C:/your/private/demo/instance

# Multilingual pipeline. Set TRANSLATION_PROVIDER=bedrock for a REAL remote
# translation call; passthrough retains text verbatim and displays warnings.
ASR_PROVIDER=sarvam
# Sarvam remote transmission: opt in only for synthetic/de-identified audio approved by your agreements.
SARVAM_API_KEY=
SARVAM_MODE=codemix
# unknown=auto detect; ta-IN=force Tamil; en-IN=force Indian English.
SARVAM_LANGUAGE_CODE=unknown
SARVAM_JOB_TIMEOUT_SECONDS=600
SARVAM_POLL_INTERVAL_SECONDS=5
# Optional JSON list of <=50 medical terms; defaults in vaidya/audio.py.
# SARVAM_KEYTERMS=["appendix","neutrophils","acute appendicitis"]
# To use the existing offline CPU adapter instead, set ASR_PROVIDER=faster-whisper.
WHISPER_MODEL_SIZE=tiny
# WHISPER_MODEL_PATH=C:/approved/local/model/folder
TRANSLATION_PROVIDER=passthrough
LLM_TRANSLATION_MODEL=in.openai.gpt-5.6-luna
# The Sarvam cloud API incurs usage charges. Do not send actual patient audio in this demo.
